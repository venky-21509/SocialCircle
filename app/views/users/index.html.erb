<h1>Users</h1>

<div class="row">
  <% @users.each do |user| %>
    <div class="col-md-4 mb-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <% if user.avatar.present? %>
              <%= image_tag user.avatar, class: "rounded-circle me-3", style: "width: 50px; height: 50px; object-fit: cover;" %>
            <% elsif user.profile_picture.present? %>
              <%= image_tag user.profile_picture, class: "rounded-circle me-3", style: "width: 50px; height: 50px; object-fit: cover;" %>
            <% else %>
              <div class="rounded-circle bg-secondary me-3 d-inline-block" style="width: 50px; height: 50px;"></div>
            <% end %>
            <div>
              <h5 class="card-title mb-0"><%= link_to user.name, user %></h5>
              <small class="text-muted">@<%= user.username %></small>
            </div>
          </div>
          
          <p class="card-text"><%= user.bio.present? ? user.bio : "No bio available" %></p>
          
          <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted">
              <small><%= user.followers_count %> followers</small>
            </div>
            
            <% if current_user.following?(user) %>
              <%= link_to "Following", unfollow_user_path(user), data: { turbo_method: :delete }, class: "btn btn-sm btn-secondary" %>
            <% else %>
              <% existing_follow = current_user.followed_relationships.find_by(followed: user) %>
              <% if existing_follow&.pending? %>
                <span class="btn btn-sm btn-warning">Request Sent</span>
              <% else %>
                <%= link_to "Follow", follow_user_path(user), data: { turbo_method: :post }, class: "btn btn-sm btn-primary" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
