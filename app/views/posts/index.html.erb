<div class="row">
  <div class="col-md-4" data-controller="avatar-options">
    <div class="card mb-4">
      <div class="card-header">
        <h5>Profile</h5>
      </div>
      <div class="card-body">
        <div class="text-center">
          <div class="avatar-upload-wrapper" style="position: relative; display: inline-block;">
            <% if current_user.avatar.present? %>
              <%= image_tag current_user.avatar, class: "rounded-circle mb-3 avatar-img", style: "width: 100px; height: 100px; object-fit: cover; cursor: pointer;" %>
            <% elsif current_user.profile_picture.present? %>
              <%= image_tag current_user.profile_picture, class: "rounded-circle mb-3 avatar-img", style: "width: 100px; height: 100px; object-fit: cover; cursor: pointer;" %>
            <% else %>
              <div class="rounded-circle bg-secondary d-inline-block mb-3 avatar-img" style="width: 100px; height: 100px; cursor: pointer;"></div>
            <% end %>
            <!-- Hover Edit Overlay -->
            <div class="avatar-hover-overlay" style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 100px; height: 100px; border-radius: 50%; background: rgba(0, 0, 0, 0.5); display: none; align-items: center; justify-content: center; cursor: pointer;" id="avatar-overlay">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="white" viewBox="0 0 16 16">
                <path d="M10.5 1.5H5.5c-.83 0-1.5.67-1.5 1.5v10c0 .83.67 1.5 1.5 1.5h5c.83 0 1.5-.67 1.5-1.5V3c0-.83-.67-1.5-1.5-1.5zm0 12h-5v-10h5v10z"/>
              </svg>
            </div>
          </div>
          <h5><%= current_user.name %></h5>
          <p class="text-muted">@<%= current_user.username %></p>
          <p><%= current_user.bio %></p>
          <div class="d-flex justify-content-around">
            <div class="text-center">
              <strong><%= current_user.following_count %></strong>
              <div>Following</div>
            </div>
            <div class="text-center">
              <strong><%= current_user.followers_count %></strong>
              <div>Followers</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Avatar Edit Modal -->
  <div class="modal fade" id="avatarOptionsModal" tabindex="-1" aria-labelledby="avatarOptionsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="avatarOptionsLabel">Update Avatar</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="d-grid gap-3">
            <!-- Camera Option -->
            <button type="button" class="btn btn-outline-primary d-flex align-items-center justify-content-center" style="padding: 15px;" id="camera-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 10px;">
                <path d="M4.146.146A.5.5 0 0 1 4.5 0h7a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-.5.5h-7a.5.5 0 0 1-.5-.5V.5a.5.5 0 0 1 .146-.354zM4 1v12h7V1H4z"/>
                <path d="M8 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>
              </svg>
              <span>Take a Photo</span>
            </button>
            <!-- File Upload Option -->
            <button type="button" class="btn btn-outline-primary d-flex align-items-center justify-content-center" style="padding: 15px;" id="file-upload-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 10px;">
                <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                <path d="M4.5 7a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 2a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4z"/>
              </svg>
              <span>Choose from Files</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Hidden File Input -->
  <input type="file" id="hidden-camera-input" accept="image/*" style="display: none;">
  <input type="file" id="hidden-file-input" accept="image/*" style="display: none;">
  
  <div class="col-md-8">
    <h1>Feed</h1>
    
    <!-- New Post Form -->
    <div class="card mb-4">
      <div class="card-body">
        <%= form_with(model: @post, local: true) do |form| %>
          <% if @post.errors.any? %>
            <div id="error_explanation">
              <h2><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h2>
              <ul>
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="form-group">
            <%= form.text_area :content, class: "form-control", rows: 3, placeholder: "What's on your mind?" %>
          </div>
          
          <div class="actions">
            <%= form.submit "Post", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Posts Feed -->
    <% @posts.each do |post| %>
      <div class="card mb-3">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <strong><%= link_to post.user.username, post.user %></strong>
              <small class="text-muted">- <%= time_ago_in_words(post.created_at) %> ago</small>
            </div>
            <% if post.user == current_user %>
              <%= link_to "Delete", post, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <p class="card-text"><%= post.content %></p>
          
          <!-- Likes -->
          <div class="mb-2">
            <% if post.liked_by?(current_user) %>
              <% like = post.likes.find_by(user: current_user) %>
              <%= link_to "Unlike (#{post.likes_count})", post_like_path(post, like), data: { turbo_method: :delete }, class: "btn btn-sm btn-outline-secondary" %>
            <% else %>
              <%= link_to "Like (#{post.likes_count})", post_likes_path(post), data: { turbo_method: :post }, class: "btn btn-sm btn-outline-primary" %>
            <% end %>
          </div>
          
          <!-- Comments -->
          <div class="comments-section">
            <h6>Comments (<%= post.comments_count %>)</h6>
            
            <!-- New Comment Form -->
            <div class="comment-form mb-3">
              <%= form_with(model: [post, post.comments.build], local: true) do |form| %>
                <div class="input-group">
                  <%= form.text_field :content, class: "form-control", placeholder: "Add a comment..." %>
                  <%= form.submit "Comment", class: "btn btn-outline-primary" %>
                </div>
              <% end %>
            </div>
            
            <!-- Comments List -->
            <% post.comments.includes(:user).each do |comment| %>
              <div class="comment mb-2">
                <div class="d-flex justify-content-between">
                  <strong><%= comment.user.username %></strong>
                  <small><%= time_ago_in_words(comment.created_at) %> ago</small>
                </div>
                <p class="mb-1"><%= comment.content %></p>
                <% if comment.user == current_user %>
                  <%= link_to "Delete", post_comment_path(post, comment), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-link text-danger" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
